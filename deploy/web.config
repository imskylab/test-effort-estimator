<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS front end for the Test Effort Estimator: Windows sign-in, then forwards to Node on this machine.
     Needs: URL Rewrite, Application Request Routing (proxy enabled), Windows Authentication.
     See PILOT.md, "Set up Windows sign-in with IIS". -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Test Effort Estimator" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <!-- Always overwritten with the signed-in Windows user, so a browser can't supply its own. -->
            <set name="HTTP_X_REMOTE_USER" value="{LOGON_USER}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
